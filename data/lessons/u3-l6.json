    {
      "type": "phrase",
      "en": "I teach at a primary or secondary school or a college. → I'm a teacher.",
      "cs": "Učím na základní nebo střední škole nebo na vyšší vzdělávací instituci. → Jsem učitel.",
      "note": "teacher, lecturer or professor?"
    },
    {
      "type": "phrase",
      "en": "I teach at university. → I'm a lecturer.",
      "cs": "Učím na univerzitě. → Jsem vysokoškolský pedagog.",
      "note": "teacher, lecturer or professor?"
    },
    {
      "type": "phrase",
      "en": "I am the head lecturer at my university department. → I'm the professor.",
      "cs": "Jsem vedoucí pedagog na své univerzitní katedře. → Jsem profesor.",
      "note": "teacher, lecturer or professor?"
    },
    {
      "type": "phrase",
      "en": "For everyday schoolwork, homework and tests we get marks.",
      "cs": "Za běžnou školní práci, domácí úkoly a testy dostáváme marks.",
      "note": "mark or grade?"
    },
    {
      "type": "phrase",
      "en": "For exams and on school reports we get grades.",
      "cs": "Za zkoušky a na vysvědčení dostáváme grades.",
      "note": "mark or grade?"
    },
    {
      "type": "phrase",
      "en": "The teacher marks [opravuje] our work and then gives us a mark/grade [oznámkuje].",
      "cs": "Učitel opravuje naši práci a pak nám dá známku (oznámkuje).",
      "note": "mark or grade?"
    },
    {
      "type": "phrase",
      "en": "We use the word pupil to describe all young people aged 16 or less and still in compulsory [povinný] full-time education.",
      "cs": "Slovo pupil používáme pro všechny mladé lidi ve věku 16 let a méně, kteří jsou ještě v povinné denní školní docházce.",
      "note": "pupil or student?"
    },
    {
      "type": "phrase",
      "en": "After this we may use the word student, which is the only possibility when we speak of those at university.",
      "cs": "Poté můžeme použít slovo student, které je jedinou možností, když mluvíme o lidech na univerzitě.",
      "note": "pupil or student?"
